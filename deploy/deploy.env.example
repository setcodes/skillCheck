# Скопируйте в deploy/deploy.env (он в .gitignore) и заполните. В репозиторий не коммитить.

# SSH: пользователь@сервер, ключ и (необязательно) отдельный known_hosts
SSH_TARGET=deploy@203.0.113.10
SSH_KEY=~/.ssh/id_ed25519
SSH_KNOWN_HOSTS=

# Сайт
DOMAIN=skillcheck.example.com
BRANCH=main
EMAIL=

# Reverse proxy на сервере: каталог compose-проекта, имя проекта и общая Docker-сеть
EDGE_DIR=/opt/edge
EDGE_PROJECT=edge
EDGE_NETWORK=edge
# EDGE_SERVICE=nginx
# CERTBOT_SERVICE=certbot
# CERTBOT_PROFILE=operations
# WEBROOT=/var/www/certbot
# CERTS=/etc/letsencrypt
# APP_DIR=/opt/skillcheck
