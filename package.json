{
  "name": "skillcheck-interview-suite",
  "private": true,
  "version": "1.0.0",
  "description": "Тренажёр технических собеседований: теория, задачи с автопроверкой, кейсы и мок-интервью",
  "homepage": "https://skillcheck.setcode.ru/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/setcodes/skillCheck.git"
  },
  "bugs": "https://github.com/setcodes/skillCheck/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate-questions": "tsx scripts/validate-questions.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run validate-questions && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@vitejs/plugin-react": "^5.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.0",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "2.1.9",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
